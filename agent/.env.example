# Environment for the CrisisTwin fire-watch agent.
#
# Copy to agent/.env and fill in your own values:
#
#     cp agent/.env.example agent/.env
#
# The repository .gitignore ignores `.env` and `.env.*` and un-ignores this
# example file, so a filled-in agent/.env stays out of Git. Keep it that way:
# every value below is a placeholder, and no real key belongs in this file, in
# a fixture, in a log line, in a screenshot, or in the browser bundle under
# app/. The agent is a local process; nothing here is read by the web app.
#
# The names below are the ones crisistwin_agent/config.py declares. If the two
# ever drift, config.py is the authority and this file should be corrected.

# --- Required ---

# Anthropic API key for the agent loop. https://console.anthropic.com/
# ANTHROPIC_AUTH_TOKEN, or a profile stored by `ant auth login`, works instead;
# config.py accepts either and fails early with a clear message if it finds
# neither.
ANTHROPIC_API_KEY=sk-ant-replace-with-your-own-key

# NASA FIRMS MAP_KEY for satellite fire detections. Free, no cost, issued by
# email from https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Required only for the live FIRMS detection source; the offline fixture source
# runs without it. FIRMS puts this key in the request URL, so it
# will appear in any transcript of that URL: never log a built FIRMS URL, never
# paste one into an issue, and never commit a response fixture that still has
# the key in its recorded request.
FIRMS_MAP_KEY=replace-with-your-firms-map-key

# --- Optional overrides ---

# Claude model for the agent loop. Default: claude-opus-5
# CRISISTWIN_AGENT_MODEL=claude-opus-5

# Thinking/spend effort: low, medium, high, xhigh, or max. Default: high
# CRISISTWIN_EFFORT=high

# Hard ceiling on model turns in one watch run, so a run cannot loop without
# bound. Default: 24
# CRISISTWIN_MAX_TURNS=24

# Which detection source the WATCH stage uses: `firms` (live NASA FIRMS) or
# `fixture` (offline, synthetic, clearly labelled as a fixture, not live data).
# Default: firms
# CRISISTWIN_DETECTION_SOURCE=firms

# Detection fixture used when the source is `fixture`.
# Default: the packaged fixtures/berkeley_detections.json
# CRISISTWIN_FIXTURE_PATH=./fixtures/berkeley_detections.json

# Node.js executable that runs the fire-model sidecar. Default: `node` on PATH.
# The sidecar in agent/bridge/ requires Node 22.15 or newer.
# CRISISTWIN_NODE_BIN=/usr/local/bin/node

# Projection horizon in simulation minutes from ignition: 120, 180, or 360,
# matching the horizons the fire model supports. Default: 180
# CRISISTWIN_HORIZON_MINUTES=180

# Python logging level for the agent process. Default: INFO
# CRISISTWIN_LOG_LEVEL=INFO
