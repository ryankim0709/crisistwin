# Local credentials and configuration
.env
.env.*
!.env.example
*.pem
*.key

# Local agent run output: drafted and delivered advisories from a watch run.
# These are experimental planning artefacts, not records to keep in Git.
agent/review_queue.jsonl
agent/*.jsonl

# Local caches and build outputs
node_modules/
.next/
dist/
coverage/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.tsbuildinfo

# Local operating system files and logs
.DS_Store
*.log

# Xcode per-user state (the project and workspace files themselves stay tracked)
xcuserdata/
*.xcuserstate
DerivedData/

# Generated replay bundles (python3 -m sim ... bundle); rebuild locally
app/public/replays/**/*.json
app/public/simulations/**/*.json

# Editor swap files
*.swp

# Incident-package artifacts live in MongoDB Atlas; fetch with `python3 -m tools.mongo_data pull`
data/incidents/*/*/raw/
data/incidents/*/*/normalized/
data/incidents/*/*/derived/

# Prebuilt landscape packages live in MongoDB GridFS; rebuild with tools/build_landscape_regions
data/landscapes/
