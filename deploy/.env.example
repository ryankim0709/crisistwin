# Copy to deploy/.env on the VM (git-ignored). Placeholders only; never commit real values.
# Public hostname whose DNS A record points at this VM. Caddy issues the certificate for it.
SITE_ADDRESS=drill.example.com

# Django. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=<long-random-string>

# App data on MongoDB Atlas (allow this VM's public IP in Atlas Network Access).
MONGODB_URI=mongodb+srv://<username>:<url-encoded-password>@<cluster-host>/?retryWrites=true&w=majority&appName=crisistwin
MONGODB_DATABASE=crisistwin
# Caches live in the local mongod container (compose sets CACHE_MONGODB_URI itself).
CACHE_MONGODB_DATABASE=crisistwin_cache

# Required for multi-phone use: without the token every client is the controller.
LIVE_CONTROLLER_TOKEN=<long-random-controller-token>
LIVE_INVITE_CODE=<drill-invite-code>
# Optional: incident the phones follow by default (Studio drill id); empty = the Camp drill.
LIVE_ACTIVE_INCIDENT_ID=

# Server-side only, all optional. Paid usage.
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_TTS_MODEL=
VOICE_MODEL=
APIFY_TOKEN=
APIFY_ACTOR_ID=
INTEL_FEEDS_CONTACT=<ops-contact-email-or-url>
