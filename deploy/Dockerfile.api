# Production API image. Build context is the repository root (docker-compose.yml sets it):
# the live twin reads sim/, tools/, data/ and the replay bundle outside app/backend.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 CRISISTWIN_REPO_ROOT=/repo
WORKDIR /app
COPY app/backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY app/backend/ /app/
COPY sim /repo/sim
COPY tools /repo/tools
COPY data /repo/data
# Generated, not committed: fetch with tools.mongo_data pull first (docs/deploy.md).
COPY app/public/replays /repo/app/public/replays
ENV LIVE_DRILL_BUNDLE=/repo/app/public/replays/camp-2018.json
EXPOSE 8000
# ONE worker on purpose: the live traffic twin and simulated people live in process memory,
# so a second worker would run a second, divergent twin (docs/deploy.md "Why one worker").
# Concurrency comes from threads. Do not raise --workers.
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", \
     "--workers", "1", "--worker-class", "gthread", "--threads", "32", \
     "--timeout", "120", "--graceful-timeout", "30", "--access-logfile", "-"]
