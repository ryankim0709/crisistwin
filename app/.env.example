# Copy to app/.env for Compose, or export these variables for host Django.
# Keep credentials in the ignored .env or your shell, never in VITE_* variables.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=insecure-local-development-only-crisistwin
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Multi-phone drill (ADR 0034). Defaults serve this machine only. To let phones in:
#   CT_BIND_ADDR=0.0.0.0   publish ports 5173 and 8000 on every interface (Wi-Fi), default 127.0.0.1
#   DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,<mac>.local,<tunnel-host>
#   VITE_ALLOWED_HOSTS=<tunnel-host>   (".local" is always allowed)
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://<tunnel-host>   (only if a browser POSTs through the tunnel)
# Also set LIVE_CONTROLLER_TOKEN below: without it every client is the controller.
CT_BIND_ADDR=127.0.0.1
VITE_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
MONGODB_URI=mongodb+srv://<username>:<url-encoded-password>@<cluster-host>/?retryWrites=true&w=majority&appName=crisistwin
MONGODB_DATABASE=crisistwin

# Alternatively export MONGODB_URI="$(cat ~/.mongodb_uri)" before starting Compose.
# Local MongoDB: mongodb://127.0.0.1:27017 on the host, or
# mongodb://host.docker.internal:27017 from Docker Desktop (must be reachable).
# Host Django reads exported shell variables, not this file automatically.
# Override Vite's host proxy through the shell: VITE_API_PROXY_TARGET=... npm run dev

# Optional: enables POST /api/replay/explain (AI explanation of replay results).
# Paid Anthropic API usage. Keep the real key in your shell or an ignored app/.env only.
ANTHROPIC_API_KEY=

# Optional: enables POST /api/intel/runs and ingest by run id (Apify Actor
# actors/incident-intel). Paid Apify usage. Server-side only, like the Anthropic key.
APIFY_TOKEN=
APIFY_ACTOR_ID=

# Open live feeds (NWS alerts, Caltrans lane closures, WFIGS fires): no keys, free.
# The contact goes in the User-Agent that NWS asks for. Placeholders only.
INTEL_FEEDS_CONTACT=<ops-contact-email-or-url>
INTEL_FEEDS_NWS_AREA=CA
INTEL_FEEDS_CALTRANS_DISTRICTS=3

# Incident-data store (MongoDB Atlas) used by `python3 -m tools.mongo_data push|pull`.
# Export in your shell; keep the real connection string out of Git.
MONGODB_URI=
MONGODB_DB=crisistwin

# Live drill API (/api/live/, docs/live-reports.md). Placeholders only; real values stay in your shell.
# Leave LIVE_CONTROLLER_TOKEN empty and /live needs no token (untokened requests are the controller).
# Set it to lock the controller endpoints; the Vite dev proxy then signs /live's calls with it.
# Unset invite code -> responder join returns 403.
LIVE_CONTROLLER_TOKEN=
LIVE_INVITE_CODE=<drill-invite-code>
# Optional: replay bundle path (default app/public/replays/camp-2018.json) and rationale model.
LIVE_DRILL_BUNDLE=
# Optional: where Studio drill packages are stored (default app/backend/var/packages, git-ignored).
LIVE_PACKAGES_DIR=
LIVE_RATIONALE_MODEL=claude-opus-5-5
