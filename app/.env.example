# Copy to app/.env for Compose, or export these variables for host Django.
# Keep credentials in the ignored .env or your shell, never in VITE_* variables.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=insecure-local-development-only-crisistwin
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
MONGODB_URI=mongodb+srv://<username>:<url-encoded-password>@<cluster-host>/?retryWrites=true&w=majority&appName=crisistwin
MONGODB_DATABASE=crisistwin

# Alternatively export MONGODB_URI="$(cat ~/.mongodb_uri)" before starting Compose.
# Local MongoDB: mongodb://127.0.0.1:27017 on the host, or
# mongodb://host.docker.internal:27017 from Docker Desktop (must be reachable).
# Host Django reads exported shell variables, not this file automatically.
# Override Vite's host proxy through the shell: VITE_API_PROXY_TARGET=... npm run dev
