# Optional: Compose works with local-only defaults without this file.
# These are development values, not deployment credentials.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=insecure-local-development-only-crisistwin
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
POSTGRES_DB=crisistwin
POSTGRES_USER=crisistwin
POSTGRES_PASSWORD=crisistwin-dev-only

# Host Django uses 127.0.0.1:5434; Compose supplies db:5432 automatically.
# Host Django reads exported shell variables, not this file automatically.
# Override Vite's host proxy through the shell: VITE_API_PROXY_TARGET=... npm run dev

# Optional: enables POST /api/replay/explain (AI explanation of replay results).
# Paid Anthropic API usage. Keep the real key in your shell or an ignored app/.env only.
ANTHROPIC_API_KEY=
