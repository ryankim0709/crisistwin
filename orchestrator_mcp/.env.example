# Environment for the controller MCP server (python -m crisistwin_mcp). Placeholders only; the
# server reads its process environment (set these in the MCP client config, not in a committed file).
CRISISTWIN_API_BASE=http://localhost:8000
CRISISTWIN_CONTROLLER_TOKEN=<LIVE_CONTROLLER_TOKEN of the backend>
ORCH_AGENT_NAME=orchestrator
# ORCH_ALLOW_CLOCK=1        # exposes set_drill (changes the shared drill clock)
# ORCH_INCIDENT_ID=camp-2018-drill
# ORCH_HTTP_TIMEOUT_S=120
